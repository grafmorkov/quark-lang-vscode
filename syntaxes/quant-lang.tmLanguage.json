{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Quant",
	"scopeName": "source.quant",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#chars"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#attributes"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#types"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#modules"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#constants"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"begin": "/\\*",
					"end": "\\*/",
					"name": "comment.block.quant"
				},
				{
					"match": "//.*$",
					"name": "comment.line.double-slash.quant"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"begin": "\"",
					"end": "\"",
					"name": "string.quoted.double.quant",
					"patterns": [
						{
							"match": "\\\\[ntr0\"'\\\\]",
							"name": "constant.character.escape.quant"
						}
					]
				}
			]
		},
		"chars": {
			"patterns": [
				{
					"begin": "'",
					"end": "'",
					"name": "string.quoted.single.quant"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
					"name": "constant.numeric.quant"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"match": "\\b(func|extern|struct|enum|if|else|while|switch|break|continue|return|load|using|region|mut|as|as!|sizeof|alloc)\\b",
					"name": "keyword.control.quant"
				},
				{
					"match": "\\b(case|default)\\b(?=\\s*:)",
					"name": "keyword.control.label.quant"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"match": "\\b(void|bool|char|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|str)\\b",
					"name": "storage.type.quant"
				},
				{
					"match": "[*&][A-Za-z_][A-Za-z0-9_]*",
					"name": "storage.type.pointer.quant"
				}
			]
		},
		"attributes": {
			"patterns": [
				{
					"match": "@[A-Za-z_][A-Za-z0-9_]*",
					"name": "entity.name.function.decorator"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"match": "\\bfunc\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "entity.name.function.quant"
						}
					}
				},
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
					"name": "support.function.quant"
				}
			]
		},
		"modules": {
			"patterns": [
				{
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)+",
					"name": "entity.name.namespace.quant"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"match": "(\\+=|-=|\\*=|/=|&=|\\|=|==|!=|<=|>=|&&|\\|\\||as!|as|[+\\-*/=<>&|])",
					"name": "keyword.operator.quant"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"match": "\\b(true|false|null)\\b",
					"name": "constant.language.quant"
				}
			]
		}
	}
}