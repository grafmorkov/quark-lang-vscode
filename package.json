{
  "name": "quant",
  "displayName": "Quant Language",
  "publisher": "grafmorkov",
  "description": "Language support for the Quant programming language.",
  "version": "0.0.1",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/quant-lang/vscode-extension"
  },
  "homepage": "https://github.com/quant-lang",
  "bugs": {
    "url": "https://github.com/quant-lang/quant/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "quant",
    "language",
    "compiler",
    "syntax",
    "highlighting"
  ],
  "activationEvents": [
    "onLanguage:quant"
  ],
  "contributes": {
    "languages": [
      {
        "id": "quant-lang",
        "aliases": [
          "Quant",
          "quant"
        ],
        "extensions": [
          ".qu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quant-lang",
        "scopeName": "source.quant",
        "path": "./syntaxes/quant-lang.tmLanguage.json"
      }
    ]
  }
}
